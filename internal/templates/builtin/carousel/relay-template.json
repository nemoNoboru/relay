{
  "schema": 1,
  "id": "carousel",
  "name": "Images carousel",
  "description": "A swipeable carousel of images with a caption.",
  "version": "1.0.0",
  "fields": [
    { "name": "title", "type": "text", "required": true, "max": 160 },
    { "name": "images", "type": "gallery", "required": true, "accept": "image/*" },
    { "name": "caption", "type": "textarea", "max": 2000 }
  ],
  "entry": "prepublish.html",
  "script": "publish.js"
}
