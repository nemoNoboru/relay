{
  "schema": 1,
  "id": "jetset",
  "name": "Jet Set Radio",
  "description": "A loud, graffiti-and-radio playlist with a street-poster look.",
  "version": "1.0.0",
  "fields": [
    { "name": "title", "type": "text", "required": true, "max": 160 },
    { "name": "description", "type": "textarea", "max": 2000 },
    { "name": "tracks", "type": "audio", "required": true, "accept": "audio/*" }
  ],
  "entry": "prepublish.html",
  "script": "publish.js"
}
